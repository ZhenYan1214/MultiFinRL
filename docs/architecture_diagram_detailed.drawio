        <mxCell id="original-text-329" value="共享 Fusion 僅用 AAPL+NVDA 的 Train 期間聯合訓練" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;verticalAlign=middle;spacing=0;align=center;fontSize=11.5;fontStyle=0;fontColor=#333333;fontFamily=Noto Sans CJK TC;" vertex="1" parent="1">
