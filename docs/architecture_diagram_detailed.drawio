        <mxCell id="original-text-328" value="多股票擴充實驗" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;verticalAlign=middle;spacing=0;align=center;fontSize=13.5;fontStyle=1;fontColor=#1a1a1a;fontFamily=Noto Sans CJK TC;" vertex="1" parent="1">
